<Window x:Class="GRIF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GRIF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d"
        Title="GRIF - Gost and RDF Information Formatter" 
        Height="250" Width="350" 
        ResizeMode="NoResize" 
        Icon="Sources\grif2.jpg"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="10">
        <TabControl Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Профили модели" 
                     Style="{StaticResource MaterialDesignTabItem}">
                <StackPanel Margin="0,10,0,0">
                    <Label Content="Выберите профиль модели"
                           Style="{StaticResource MaterialDesignLabel}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"
                           FontSize="15"
                           FontWeight="Bold"/>

                    <ComboBox Style="{StaticResource MaterialDesignComboBox}"
                              Width="250" Height="30"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,10"
                              SelectedItem="{Binding SelectedModelDocument, Mode=TwoWay}"
                              ItemsSource="{Binding ModelDocuments}"
                              DisplayMemberPath="Name"/>

                    <!--<ProgressBar 
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Width="250" Height="5"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,10"/>-->

                    <Button Content="{Binding ProgressText}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            HorizontalAlignment="Center"
                            Width="200" Height="35"
                            Margin="0,5,0,0"
                            Command="{Binding CreateWithTemplate_ModelDocumentCommand}"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold" Foreground="#C4F1F1F1"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Профили обмена" 
                     Style="{StaticResource MaterialDesignTabItem}">
                <StackPanel Margin="0,10,0,0">
                    <Label Content="Выберите профиль обмена"
                           Style="{StaticResource MaterialDesignLabel}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"
                           FontSize="15"
                           FontWeight="Bold"/>

                    <ComboBox Style="{StaticResource MaterialDesignComboBox}"
                              Width="250" Height="30"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,10"
                              SelectedItem="{Binding SelectedExchangeDocument, Mode=TwoWay}"
                              ItemsSource="{Binding ExchangeDocuments}"
                              DisplayMemberPath="NameWithAdditionalInfo"/>

                    <!--<ProgressBar 
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Width="250" Height="5"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,10"/>-->

                    <Button Content="{Binding ProgressText}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            HorizontalAlignment="Center"
                            Width="200" Height="35"
                            Margin="0,5,0,0"
                            Command="{Binding CreateWithTemplate_ExchangeDocumentCommand}"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold" Foreground="#C4F1F1F1"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>