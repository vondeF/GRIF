<UserControl x:Class="GRIF.UserControls.UserControl_TableBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GRIF.UserControls"
             xmlns:converters="clr-namespace:GRIF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GRIF;component/Themes/ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:SingleColumnRowConverter x:Key="SingleColumnRowConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border 
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="2" 
            Background="LightGray" 
            BorderBrush="Gray"
            BorderThickness="0"
            CornerRadius="15"
            Margin="5"/>

        <Label 
            Grid.Column="0"
            Grid.Row="0"
            VerticalAlignment="Center"
            Margin="15,0,5,0" 
            FontWeight="Bold" 
            Content="{Binding DisplayName}"/>

        <DataGrid 
            x:Name="TableDataGrid"
            AutoGenerateColumns="False" 
            BorderThickness="0" 
            Grid.Column="0"
            Grid.Row="1"
            Margin="15,5,5,10" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            IsReadOnly="True"
            ItemsSource="{Binding FilteredRows}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Identical">
                            <Setter Property="Background" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Added">
                            <Setter Property="Background" Value="#FFDEEFBB" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Deleted">
                            <Setter Property="Background" Value="#f5c798" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="EditedNew">
                            <Setter Property="Background" Value="#5c9cff" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="EditedOld">
                            <Setter Property="Background" Value="#a3c4ff" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        
        <!--
        <TextBox 
            Grid.Column="1"
            Grid.Row="0"
            Width="140" 
            Height="30" 
            Style="{StaticResource NumberTextBoxStyle}" 
            Text="{Binding NumberOfEditing, UpdateSourceTrigger=PropertyChanged}" 
            local:TextBoxBehavior.AllowPositiveNumbers="True"/>
        -->
        
        <StackPanel 
            Grid.Column="1" 
            Grid.Row="1"
            Margin="10,10,10,10" 
            VerticalAlignment="Top">

            <Label 
                FontWeight="Bold" 
                Content="Изменения данных"/>

            <CheckBox xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                IsChecked="{Binding ShowIdentical}"
                Content="Идентичные"
                HorizontalAlignment="Left" FontSize="12" Height="25" Background="White"/>
            
            <CheckBox 
                IsChecked="{Binding ShowAdded}"
                Content="Добавленные"
                HorizontalAlignment="Left"
                Background="#FFDEEFBB" FontSize="12" Height="25"/>

            <CheckBox 
                IsChecked="{Binding ShowDeleted}"
                Content="Удаленные"
                HorizontalAlignment="Left"
                Background="#f5c798" FontSize="12" Height="25"/>

            <CheckBox 
                IsChecked="{Binding ShowEditedNew}"
                Content="Измененные"
                HorizontalAlignment="Left"
                Background="#5c9cff" FontSize="12" Height="25"/>
            
            <TextBlock Text="(стало)" FontSize="10" Margin="28,-7,0,0"/>

            <CheckBox 
                IsChecked="{Binding ShowEditedOld}"
                Content="Измененные"
                HorizontalAlignment="Left"
                Background="#a3c4ff" FontSize="12" Height="25"/>

            <TextBlock Text="(было)" FontSize="10" Margin="28,-7,0,0"/>

            <StackPanel
                Orientation="Horizontal"
                Margin="0,10,0,0">
                <Button 
                    ToolTip="Сбросить все сортировки и фильтры"
                    Style="{StaticResource CenterContentButtonStyle}"
                    Command="{Binding ClearFiltersCommand}"
                    Height="20" 
                    Width="20"
                    HorizontalAlignment="Left">
                    <Image Source="/GRIF;component/Sources/clearAllSorts.png"/>
                </Button>
                <Label
                    Content="Сброс фильтров"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>
