<UserControl x:Class="GRIF.UserControls.UserControl_TextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GRIF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GRIF;component/Themes/ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/> <!-- было 40 -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border 
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="2" 
            Background="LightGray" 
            BorderBrush="Gray"
            BorderThickness="0"
            CornerRadius="10"
            Margin="5"/>

        <Label 
            Grid.Column="0"
            Grid.Row="0"
            VerticalAlignment="Center"
            Margin="15,0,5,0" 
            FontWeight="Bold" 
            Content="{Binding DisplayName}"/>
        
        <!--
        <TextBox 
            Grid.Column="1"
            Grid.Row="0"
            Width="140" 
            Height="30" 
            Style="{StaticResource NumberTextBoxStyle}" 
            Text="{Binding NumberOfEditing, UpdateSourceTrigger=PropertyChanged}" 
            local:TextBoxBehavior.AllowPositiveNumbers="True"/>
        -->
        
        <RichTextBox
            Grid.Column="0"
            Grid.Row="1"
            x:Name="RichTextBoxControl"
            Style="{StaticResource CustomRichTextBoxStyle}"/>

        <StackPanel
            Orientation="Horizontal"
            Grid.Column="1"
            Grid.Row="1"
            Margin="10"
            VerticalAlignment="Top"
            HorizontalAlignment="Center">

            <Button
                ToolTip="Редактирование текстового раздела"
                Style="{StaticResource CenterContentButtonStyle}"
                Width="40" 
                Cursor="Hand"
                Command="{Binding EditCommand}">
                <Image Source="/GRIF;component/Sources/edit.png" Margin="3,0,0,0" Width="40" Height="35"/>
            </Button>

            <Button
                ToolTip="Возврат текстового раздела к исходному состоянию"
                Style="{StaticResource CenterContentButtonStyle}"
                Width="40" 
                Cursor="Hand"
                Command="{Binding RestoreCommand}">
                <Image Source="/GRIF;component/Sources/goTotallyBack.png" Margin="3,0,0,0" Width="40" Height="35"/>
            </Button>

        </StackPanel>

        <Border 
            Grid.Column="1"
            Grid.Row="1"
            Height="23"
            Width="80"
            Margin="0,60,0,0"
            CornerRadius="10"
            Background="Orange"
            VerticalAlignment="Top"
            Visibility="{Binding IsEdited, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label 
                Content="Изменен"
                FontSize="10"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                FontWeight="Bold"/>
        </Border>

        <Border
            Grid.Row="1"
            Height="1"        
            Background="#FFD2D2D2"
            VerticalAlignment="Bottom"
            Margin="10,0,0,5" 
            CornerRadius="0.5"/>
            
    </Grid>

</UserControl>
