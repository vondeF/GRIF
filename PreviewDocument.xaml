<Window x:Class="GRIF.PreviewDocument"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GRIF"
        xmlns:userControls="clr-namespace:GRIF.UserControls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d"
        Title="{Binding Title}" MinHeight="500" Height="500" MinWidth="950" Width="950" Icon="Sources\grif2.jpg">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GRIF;component/Themes/ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="90"/>
            <RowDefinition Height ="40"/>
            <RowDefinition/>
            <RowDefinition Height ="40"/>
        </Grid.RowDefinitions>
        
        <Rectangle 
            Grid.Row="3" 
            Grid.Column="0" 
            Grid.ColumnSpan="2" 
            Fill="LightGray"/>

        <Border BorderBrush="Transparent" 
        Background="#9dbed1"
        BorderThickness="2" 
        Grid.Row="0"
        CornerRadius="20"
        Margin="10,13,10,13">

            <Grid Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Visibility, ElementName=BtnLoadTemplate, Converter={StaticResource LengthConverter}}"/>
                    <ColumnDefinition Width="{Binding Visibility, ElementName=BtnSaveTemplate, Converter={StaticResource LengthConverter}}"/>
                    <ColumnDefinition Width="{Binding Visibility, ElementName=BtnWriteDiff, Converter={StaticResource LengthConverter}}"/>
                    <ColumnDefinition Width="{Binding Visibility, ElementName=BtnWriteAll, Converter={StaticResource LengthConverter}}"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnLoadTemplate"
                Grid.Column="0"
                Content="Загрузить шаблон" 
                Style="{StaticResource RoundedButtonStyle}" 
                ToolTip="Открывает проводник для выбора шаблона" 
                Command="{Binding LoadTemplateCommand}"
                Visibility="{Binding AreTemplateElementsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button x:Name="BtnSaveTemplate"
                Grid.Column="1"
                Content="Сохранить как шаблон" 
                Style="{StaticResource RoundedButtonStyle}" 
                ToolTip="Текущее состояние ГОСТ сохраняется в качестве шаблона и будет автоматически загружено при следующем запуске"
                Command="{Binding SaveTemplateCommand}"
                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button x:Name="BtnWriteDiff"
                Grid.Column="2"
                Content="Выгрузить изменения" 
                Style="{StaticResource RoundedButtonStyle}"
                ToolTip="Формирует файл .docx с изменениями ГОСТ относительно загруженного шаблона"
                Command="{Binding WriteDiffCommand}"
                Visibility="{Binding IsValidationSuccesfull, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button x:Name="BtnWriteAll"
                Grid.Column="3"
                Content="Выгрузить документ" 
                Style="{StaticResource RoundedButtonStyle}"
                ToolTip="Формирует файл ГОСТ в формате .docx"
                Command="{Binding WriteAllCommand}"
                Visibility="{Binding IsValidationSuccesfull, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="1"
            Margin="10,0,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Left">

            <Button
                ToolTip="Производит возврат к окну выбору документа"
                Style="{StaticResource CenterContentButtonStyle}"
                Click="Back_Click" 
                Width="40" 
                Cursor="Hand">
                <Image Source="/GRIF;component/Sources/back.png" Width="35" Height="35"/>
            </Button>

            <Label 
                Content="Область редактирования"  
                Foreground="Black" 
                FontWeight="Bold" 
                VerticalAlignment="Center" 
                FontSize="13"
                Visibility="{Binding IsValidationSuccesfull, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="10,0,10,0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Visibility="{Binding IsValidationSuccesfull, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <Label 
                Content="{Binding DisplayName}"  
                Foreground="Black" 
                FontWeight="Bold" 
                VerticalAlignment="Center" 
                FontSize="13"
                Margin="0,0,10,0"
                Visibility="{Binding IsValidationSuccesfull, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!--
            <TextBox 
                Grid.Column="1"
                Grid.Row="0"
                Width="140" 
                Height="30" 
                Style="{StaticResource NumberTextBoxStyle}" 
                Text="{Binding NumberOfEditing, UpdateSourceTrigger=PropertyChanged}" 
                userControls:TextBoxBehavior.AllowPositiveNumbers="True"/>
            -->
            
        </StackPanel>

        <ScrollViewer 
            VerticalScrollBarVisibility="Auto"   
            Grid.Row="2">
            
            <StackPanel
                Margin="10,0,10,0"
                Orientation="Vertical">

                <TextBlock 
                    Text="{Binding TemplatePath}" 
                    TextWrapping="Wrap"
                    Margin="10,10,10,0" 
                    FontWeight="Bold" />
                
                <Border 
                    Background="#FFFFBEBE"
                    Grid.Row="0"
                    CornerRadius="15"
                    VerticalAlignment="Top"
                    Margin="0,10,0,10"
                    Visibility="{Binding IsValidationSuccesfull, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock 
                        Text="{Binding Information}" 
                        Background="Transparent"
                        Margin="10,10,10,10"/>
                </Border>
                
                <ItemsControl ItemsSource="{Binding Controls}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
           
            </StackPanel>
        </ScrollViewer>

        <UniformGrid 
            Columns="3"
            Grid.Row="3">

            <Label 
                Content="Элементы управления БД:" 
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="10,0,0,0"
                FontWeight="Bold"/>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">
                <TextBlock 
                    Text="Создание новой версии документа" 
                    Margin="0,4,5,0" 
                    Width="150" 
                    TextWrapping="Wrap" 
                    TextAlignment="Right"/>
                <Button
                    Style="{StaticResource CenterContentButtonStyle}"
                    Command="{Binding SaveToDbCommand}"
                    Width="40" 
                    Cursor="Hand">
                    <Image Source="/GRIF;component/Sources/assignTableVersion.png" Width="30" Height="30"/>
                </Button>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <TextBlock 
                    Text="Восстановление предыдущей версии" 
                    Margin="0,4,5,0"
                    Width="160" 
                    TextWrapping="Wrap" 
                    TextAlignment="Right"/>
                <Button
                    Style="{StaticResource CenterContentButtonStyle}"
                    Command="{Binding DeleteLastVersionFromDbCommand}"
                    Width="40" 
                    Cursor="Hand">
                    <Image Source="/GRIF;component/Sources/goTotallyBackTable.png" Width="25" Height="25"/>
                </Button>
            </StackPanel>
        </UniformGrid>
    </Grid>
</Window>
